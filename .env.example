# Wideweave environment configuration.
# Copy this file to `.env` and fill in the values. Variables prefixed with
# VITE_ are inlined into the client bundle at build time. NEVER put a secret
# key here — only the publishable key is safe in the client.

# Supabase project URL. Format: https://abcdefghij.supabase.co
# You can find this in your Supabase dashboard at Settings → API.
VITE_SUPABASE_URL=

# Supabase publishable key (new format: sb_publishable_...).
# This is the safe-to-be-public key. The secret key (sb_secret_...) must
# NEVER appear in the client.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
